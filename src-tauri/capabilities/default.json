{
  "$schema": "../gen/schemas/desktop-schema.json",
  "capabilities": [
    {
      "identifier": "default",
      "description": "Capability for primary application windows",
      "windows": ["main", "ai-chat"],
      "permissions": [
        "core:default",
        "core:webview:allow-create-webview-window",
        "core:window:allow-show",
        "core:window:allow-set-focus",
        "core:window:allow-close",
        "opener:default",
        "dialog:allow-message",
        "dialog:default",
        "shell:allow-open",
        "shell:default",
        "window-state:default",
        "fs:default",
        "fs:allow-write-text-file"
      ]
    },
    {
      "identifier": "intruder-results-window",
      "description": "Capability for standalone intruder results windows",
      "windows": ["intruder-results-*"],
      "permissions": ["core:default", "core:window:allow-close"]
    },
    {
      "identifier": "help-center-window",
      "description": "Capability for standalone help center window",
      "windows": ["help-center"],
      "permissions": ["core:default", "core:window:allow-close"]
    }
  ]
}
